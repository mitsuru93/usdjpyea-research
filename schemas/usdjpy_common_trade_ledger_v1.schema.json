{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mitsuru93/usdjpyea-research/schemas/usdjpy_common_trade_ledger_v1.schema.json",
  "title": "USDJPY Common Trade Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "study_id",
    "candidate_id",
    "candidate_version",
    "strategy_id",
    "source",
    "broker",
    "symbol",
    "lot",
    "side",
    "entry_utc",
    "entry_price",
    "exit_utc",
    "realized_pl_jpy",
    "position_id",
    "source_trade_id",
    "candidate_visibility",
    "validation_run_id",
    "artifact_digest"
  ],
  "properties": {
    "study_id": {"type": "string", "minLength": 1},
    "hypothesis_id": {"type": ["string", "null"]},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "strategy_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "broker": {"type": "string", "minLength": 1},
    "symbol": {"const": "USDJPY"},
    "lot": {"type": "number", "exclusiveMinimum": 0},
    "side": {"enum": ["LONG", "SHORT"]},
    "signal_utc": {"type": ["string", "null"], "format": "date-time"},
    "decision_utc": {"type": ["string", "null"], "format": "date-time"},
    "entry_utc": {"type": "string", "format": "date-time"},
    "entry_bid": {"type": ["number", "null"]},
    "entry_ask": {"type": ["number", "null"]},
    "entry_price": {"type": "number"},
    "exit_utc": {"type": "string", "format": "date-time"},
    "exit_bid": {"type": ["number", "null"]},
    "exit_ask": {"type": ["number", "null"]},
    "exit_price": {"type": ["number", "null"]},
    "realized_pl_jpy": {"type": "number"},
    "spread_points": {"type": ["number", "null"], "minimum": 0},
    "commission": {"type": ["number", "null"]},
    "swap": {"type": ["number", "null"]},
    "exit_reason": {"type": ["string", "null"]},
    "position_id": {"type": "string", "minLength": 1},
    "source_trade_id": {"type": "string", "minLength": 1},
    "candidate_visibility": {
      "enum": [
        "BASELINE_AUTHORITY",
        "RESEARCH_PERIOD_CANDIDATE",
        "VALIDATION_PERIOD_RESULT",
        "VALIDATION_PERIOD_BASELINE_AUTHORITY"
      ]
    },
    "validation_run_id": {"type": "string", "minLength": 1},
    "research_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "core_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

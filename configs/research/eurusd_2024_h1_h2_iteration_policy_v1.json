{
  "version": "v1",
  "status": "authoritative_project_policy",
  "symbol": "EURUSD",
  "bar_timeframe": "H1",
  "periods": {
    "development": {
      "label": "2024_H1",
      "start_utc": "2024-01-01T00:00:00Z",
      "end_utc_exclusive": "2024-07-01T00:00:00Z"
    },
    "fixed_validation": {
      "label": "2024_H2",
      "start_utc": "2024-07-01T00:00:00Z",
      "end_utc_exclusive": "2025-01-01T00:00:00Z"
    }
  },
  "rules": {

[rows[left].family]
            left+=1
        if len(counts)>=quorum:
            return q.iloc[right]
    return None


def family_vote(events: pd.DataFrame, master: pd.DataFrame) -> tuple[pd.DataFrame,list[dict[str,Any]]]:
    details=[]; summaries=[]
    families=sorted(events.family.unique())
    for scope in SCOPES:
        ms=scope_filter(master,scope); es=scope_filter(events,scope)
        for quorum in VOTE_QUORUMS:
            for window in VOTE_WINDOWS:
                out_rows=[]
                for holdout in FOLDS:
                    train_m=ms[ms.fold!=holdout]; train_e=es[es.fold!=holdout]
                    selected={}
                    for fam in families:
                        cid,_=select_candidate(train_e,train_m,fam)
                        if cid:selected[fam]=cid
                    he=es[(es.fold==holdout)&es.candidate_id.isin(selected.values())].copy()
                    for _,g in he.groupby("trade_id"):
                        row=first_vote_event(g,quorum,window)
                        if row is not None: out_rows.append(row.to_dict())
                    hdf=pd.DataFrame(out_rows)
                    details.append({"scope":scope,"quorum":quorum,"window_minutes":window,"holdout":holdout,"families_selected":len(selected),"holdout_triggers":len(hdf),"holdout_delta_pips":round(float(hdf.delta_pips.sum()),1) if len(hdf) else 0.0,"holdout_severe1_pips":round(float(hdf.severe1_delta_pips.sum()),1) if len(hdf) else 0.0})
                combined=pd.DataFrame(out_rows) if out_rows else es.iloc[0:0]
                if len(combined):
                    for c in ["entry_utc","trigger_utc","exit_utc"]: combined[c]=pd.to_datetime(combined[c],utc=True)
                summaries.append(policy_summary(combined,ms,f"{scope}|Q{quorum}|W{window}","FAMILY_VOTE"))
    return pd.DataFrame(details),summaries


def build_state_ledger(trades: pd.DataFrame,m23:pd.DataFrame,m24:pd.DataFrame)->pd.DataFrame:
    bars={"2023":atlas.aggregate_bars(m23,5),"2024":atlas.aggregate_bars(m24,5)}
    rows=[]
    for n,tr in enumerate(trades.itertuples(index=False),start=1):
        year="2023" if str(tr.fold).startswith("2023") else "2024"
        m1=m23 if year=="2023" else m24
        context=atlas.pre_context(m1,pd.Timestamp(tr.entry_utc),int(tr.side))
        p=atlas.path_frame(bars[year],tr,5,context)
        if p.get("n",0)==0: continue
        valid=(p["completion"]<=pd.Timestamp(tr.entry_utc)+pd.Timedelta(minutes=240))
        idxs=np.flatnonzero(valid)
        crossing=0; prev_sign=None
        for j,i in enumerate(idxs,start=1):
            sign=np.sign(p["level_dist"][i])
            if prev_sign is not None and sign*prev_sign<0: crossing+=1
            if sign!=0: prev_sign=sign
            trigger=pd.Timestamp(p["completion"][i])
            ex=atlas.exit_pips(m1.loc[pd.Timestamp(tr.entry_utc):pd.Timestamp(tr.close_utc)],tr,trigger,0)
            if ex is None: continue
            recent=p["ret"][max(0,i-4):i+1]
            rows.append({
                "trade_id":tr.trade_id,"fold":tr.fold,"strategy":tr.strategy,"side":int(tr.side),"session":atlas.session_name(pd.Timestamp(tr.entry_utc)),
                "entry_utc":tr.entry_utc,"close_utc":tr.close_utc,"baseline_pips":float(tr.baseline_pips),"baseline_loser":int(float(tr.baseline_pips)<=0),
                "time_idx":j,"minutes":j*5,"trigger_utc":trigger,"exit_pips":float(ex[1]),"delta_pips":float(ex[1]-tr.baseline_pips),
                "current_norm":float(p["ret"][i]/context["scale_pips"]),"mfe_norm":float(p["mfe"][i]/context["scale_pips"]),"mae_norm":float(p["mae"][i]/context["scale_pips"]),
                "giveback_norm":float((p["mfe"][i]-p["ret"][i])/context["scale_pips"]),"level_distance_norm":float(p["level_dist"][i]/context["scale_pips"]),
                "underwater_fraction":float(np.mean(p["ret"][:i+1]<=0)),"crossings":crossing,"slope_tstat":float(atlas.rolling_tstat(recent)),
                "delta_norm":float(p["delta"][i]/context["scale_pips"]),"time_fraction":float(j/48),"pre_range_pips":float(context["pre_range_pips"]),
            })
        if n%200==0: print(json.dumps({"state_progress":n,"state_rows":len(rows)}),file=sys.stderr)
    out=pd.DataFrame(rows)
    out["entry_utc"]=pd.to_datetime(out.entry_utc,utc=True);out["trigger_utc"]=pd.to_datetime(out.trigger_utc,utc=True)
    out["month"]=out.entry_utc.dt.strftime("%Y-%m")
    return out

NUM_FEATURES=["current_norm","mfe_norm","mae_norm","giveback_norm","level_distance_norm","underwater_fraction","crossings","slope_tstat","delta_norm","time_fraction","pre_range_pips"]

@dataclass
class RegressorBundle:
    predict: Callable[[np.ndarray],np.ndarray]


def feature_matrix(df:pd.DataFrame,columns:list[str]|None=None)->tuple[np.ndarray,list[str]]:
    x=df[NUM_FEATURES+["side","session"]].copy()
    x=pd.get_dummies(x,columns=["side","session"],dtype=float).replace([np.inf,-np.inf],np.nan).fillna(0.0)
    if columns is not None: x=x.reindex(columns=columns,fill_value=0.0)
    return x.to_numpy(float),x.columns.tolist()


def fit_regressor(name:str,train:pd.DataFrame,target:np.ndarray)->tuple[RegressorBundle,list[str]]:
    X,cols=feature_matrix(train)
    if name=="RIDGE_ALPHA10":
        scaler=StandardScaler();Xs=scaler.fit_transform(X);model=Ridge(alpha=10.0).fit(Xs,target)
        return RegressorBundle(lambda z:model.predict(scaler.transform(z))),cols
    model=HistGradientBoostingRegressor(max_leaf_nodes=7,max_iter=80,learning_rate=0.05,l2_regularization=2.0,min_samples_leaf=20,random_state=RNG_SEED).fit(X,target)
    return RegressorBundle(lambda z:model.predict(z)),cols


def train_dynamic_models(train:pd.DataFrame,model_name:str)->dict[int,tuple[RegressorBundle,list[str]]]:
    by_trade={tid:g.sort_values("time_idx") for tid,g in train.groupby("trade_id")}
    value_next={tid:float(g.baseline_pips.iloc[0]) for tid,g in by_trade.items()}
    models={}
    for t in range(48,0,-1):
        rows=[];targets=[]
        for tid,g in by_trade.items():
            q=g[g.time_idx==t]
            if q.empty: continue
            rows.append(q.iloc[0]);targets.append(value_next[tid])
        if len(rows)<40: continue
        frame=pd.DataFrame(rows);target=np.asarray(targets,float)
        bundle,cols=fit_regressor(model_name,frame,target);models[t]=(bundle,cols)
        X,_=feature_matrix(frame,cols);cont=bundle.predict(X);stop=frame.exit_pips.to_numpy(float)-1.0
        v=np.maximum(stop,cont)
        for tid,val in zip(frame.trade_id,v):value_next[tid]=float(val)
    return models


def execute_dynamic(test:pd.DataFrame,models:dict[int,tuple[RegressorBundle,list[str]]],margin:float,persistence:int)->pd.DataFrame:
    out=[]
    for tid,g in test.groupby("trade_id"):
        g=g.sort_values("time_idx");run=0;chosen=None
        for _,row in g.iterrows():
            t=int(row.time_idx)
            if t not in models: continue
            bundle,cols=models[t];X,_=feature_matrix(pd.DataFrame([row]),cols);cont=float(bundle.predict(X)[0]);stop=float(row.exit_pips)-1.0
            run=run+1 if stop>=cont+margin else 0
            if run>=persistence: chosen=row;break
        if chosen is not None:
            pos=int(g.index.get_loc(chosen.name));delay=float(g.iloc[min(pos+1,len(g)-1)].exit_pips)
            out.append({
                "trade_id":tid,"fold":chosen.fold,"strategy":chosen.strategy,"side":int(chosen.side),"entry_utc":chosen.entry_utc,"trigger_utc":chosen.trigger_utc,
                "baseline_pips":float(chosen.baseline_pips),"baseline_loser":bool(chosen.baseline_loser),"candidate_pips":float(chosen.exit_pips),
                "delta_pips":float(chosen.exit_pips-chosen.baseline_pips),"severe1_delta_pips":float(chosen.exit_pips-1-chosen.baseline_pips),
                "severe2_delta_pips":float(chosen.exit_pips-2-chosen.baseline_pips),"delay5_delta_pips":float(delay-chosen.baseline_pips),
            })
    return pd.DataFrame(out)


def dynamic_policy_audit(states:pd.DataFrame,master:pd.DataFrame)->tuple[pd.DataFrame,list[dict[str,Any]]]:
    details=[];summaries=[]
    for strategy in STRATEGIES:
        ms=master[master.strategy==strategy];ss=states[states.strategy==strategy]
        for model in DYNAMIC_MODELS:
            outputs={(m,p):[] for m in DYNAMIC_MARGINS for p in PERSISTENCE}
            for holdout in FOLDS:
                train=ss[ss.fold!=holdout];test=ss[ss.fold==holdout]
                models=train_dynamic_models(train,model)
                for margin in DYNAMIC_MARGINS:
                    for pers in PERSISTENCE:
                        h=execute_dynamic(test,models,margin,pers)
                        if len(h): outputs[(margin,pers)].append(h)
                        details.append({"strategy":strategy,"model":model,"margin":margin,"persistence":pers,"holdout":holdout,"trained_time_models":len(models),"holdout_triggers":len(h),"holdout_delta_pips":round(float(h.delta_pips.sum()),1) if len(h) else 0.0,"holdout_severe1_pips":round(float(h.severe1_delta_pips.sum()),1) if len(h) else 0.0})
            for (margin,pers),parts in outputs.items():
                combined=pd.concat(parts,ignore_index=True) if parts else pd.DataFrame(columns=["baseline_loser","delta_pips","severe1_delta_pips","severe2_delta_pips","delay5_delta_pips","fold","side","entry_utc"])
                summaries.append(policy_summary(combined,ms,f"{strategy}|{model}|M{margin}|P{pers}","APPROX_OPTIMAL_STOPPING"))
    return pd.DataFrame(details),summaries

class GaussianMarkovStateModel:
    """Deterministic Gaussian Markov state-space model.

    Emissions are initialized by a diagonal Gaussian mixture. Initial and transition
    probabilities are estimated from training sequences with Laplace smoothing, then
    sequences are decoded by Viterbi. This avoids an external HMM dependency while
    preserving a hidden-state/Markov transition audit.
    """
    def __init__(self, n_components: int, random_state: int = RNG_SEED):
        self.n_components = n_components
        self.random_state = random_state

    def fit(self, X: np.ndarray, lengths: list[int]) -> "GaussianMarkovStateModel":
        self.gmm = GaussianMixture(
            n_components=self.n_components,
            covariance_type="diag",
            reg_covar=1e-4,
            n_init=10,
            max_iter=200,
            random_state=self.random_state,
        ).fit(X)
        labels = self.gmm.predict(X)
        start = np.ones(self.n_components, float)
        trans = np.ones((self.n_components, self.n_components), float)
        pos = 0
        for length in lengths:
            seq = labels[pos:pos+length]
            if len(seq):
                start[int(seq[0])] += 1
                for a, b in zip(seq[:-1], seq[1:]):
                    trans[int(a), int(b)] += 1
            pos += length
        self.log_start = np.log(start / start.sum())
        self.log_trans = np.log(trans / trans.sum(axis=1, keepdims=True))
        return self

    def _emission_logprob(self, X: np.ndarray) -> np.ndarray:
        means = self.gmm.means_
        cov = np.maximum(self.gmm.covariances_, 1e-8)
        d = X.shape[1]
        out = np.empty((len(X), self.n_components), float)
        for k in range(self.n_components):
            diff = X - means[k]
            out[:, k] = -0.5 * (d * np.log(2 * np.pi) + np.log(cov[k]).sum() + ((diff * diff) / cov[k]).sum(axis=1))
        return out

    def _viterbi_one(self, X: np.ndarray) -> np.ndarray:
        if len(X) == 0:
            return np.empty(0, int)
        emit = self._emission_logprob(X)
        dp = np.empty_like(emit)
        back = np.zeros_like(emit, dtype=int)
        dp[0] = self.log_start + emit[0]
        for t in range(1, len(X)):
            scores = dp[t-1][:, None] + self.log_trans
            back[t] = np.argmax(scores, axis=0)
            dp[t] = scores[back[t], np.arange(self.n_components)] + emit[t]
        states = np.empty(len(X), int)
        states[-1] = int(np.argmax(dp[-1]))
        for t in range(len(X)-2, -1, -1):
            states[t] = back[t+1, states[t+1]]
        return states

    def predict(self, X: np.ndarray, lengths: list[int]) -> np.ndarray:
        out = []
        pos = 0
        for length in lengths:
            out.append(self._viterbi_one(X[pos:pos+length]))
            pos += length
        return np.concatenate(out) if out else np.empty(0, int)


HMM_FEATURES=["current_norm","delta_norm","giveback_norm","level_distance_norm","underwater_fraction"]


def hmm_policy_audit(states:pd.DataFrame,master:pd.DataFrame)->tuple[pd.DataFrame,list[dict[str,Any]]]:
    details=[];summaries=[]
    for strategy in STRATEGIES:
        ms=master[master.strategy==strategy];ss=states[states.strategy==strategy]
        outputs={(k,p):[] for k in HMM_COMPONENTS for p in PERSISTENCE}
        for holdout in FOLDS:
            train=ss[ss.fold!=holdout].copy();test=ss[ss.fold==holdout].copy()
            scaler=StandardScaler().fit(train[HMM_FEATURES].replace([np.inf,-np.inf],np.nan).fillna(0.0))
            X=scaler.transform(train[HMM_FEATURES].replace([np.inf,-np.inf],np.nan).fillna(0.0));lengths=train.groupby("trade_id",sort=False).size().tolist()
            Z=scaler.transform(test[HMM_FEATURES].replace([np.inf,-np.inf],np.nan).fillna(0.0));zlengths=test.groupby("trade_id",sort=False).size().tolist()
            for k in HMM_COMPONENTS:
                hmm=GaussianMarkovStateModel(n_components=k,random_state=RNG_SEED).fit(X,lengths)
                train_states=hmm.predict(X,lengths);test_states=hmm.predict(Z,zlengths)
                train["hmm_state"]=train_states;test["hmm_state"]=test_states
                selected=[]
                for state,g in train.groupby("hmm_state"):
                    losers=g[g.baseline_loser==1];winners=g[g.baseline_loser==0]
                    benefit=float((losers.exit_pips-losers.baseline_pips-1).sum());damage=float((winners.exit_pips-winners.baseline_pips-1).sum());total=benefit+damage
                    if len(g)>=40 and len(losers)>=10 and total>0 and benefit>0 and damage>=-0.7*benefit:selected.append(int(state))
                for pers in PERSISTENCE:
                    out=[]
                    for tid,g in test.groupby("trade_id",sort=False):
                        g=g.sort_values("time_idx");run=0;chosen=None
                        for _,row in g.iterrows():
                            run=run+1 if int(row.hmm_state) in selected else 0
                            if run>=pers:chosen=row;break
                        if chosen is not None:
                            pos=int(g.index.get_loc(chosen.name));delay=float(g.iloc[min(pos+1,len(g)-1)].exit_pips)
                            out.append({"trade_id":tid,"fold":chosen.fold,"strategy":chosen.strategy,"side":int(chosen.side),"entry_utc":chosen.entry_utc,"trigger_utc":chosen.trigger_utc,"baseline_pips":float(chosen.baseline_pips),"baseline_loser":bool(chosen.baseline_loser),"candidate_pips":float(chosen.exit_pips),"delta_pips":float(chosen.exit_pips-chosen.baseline_pips),"severe1_delta_pips":float(chosen.exit_pips-1-chosen.baseline_pips),"severe2_delta_pips":float(chosen.exit_pips-2-chosen.baseline_pips),"delay5_delta_pips":float(delay-chosen.baseline_pips)})
                    h=pd.DataFrame(out)
                    if len(h):outputs[(k,pers)].append(h)
                    details.append({"strategy":strategy,"components":k,"persistence":pers,"holdout":holdout,"selected_states":json.dumps(selected),"holdout_triggers":len(h),"holdout_delta_pips":round(float(h.delta_pips.sum()),1) if len(h) else 0.0,"holdout_severe1_pips":round(float(h.severe1_delta_pips.sum()),1) if len(h) else 0.0})
        for (k,pers),parts in outputs.items():
            combined=pd.concat(parts,ignore_index=True) if parts else pd.DataFrame(columns=["baseline_loser","delta_pips","severe1_delta_pips","severe2_delta_pips","delay5_delta_pips","fold","side","entry_utc"])
            summaries.append(policy_summary(combined,ms,f"{strategy}|K{k}|P{pers}","HMM_STATE_POLICY"))
    return pd.DataFrame(details),summaries


def oracle_bounds(states:pd.DataFrame,events:pd.DataFrame,master:pd.DataFrame)->dict[str,Any]:
    best_state=states.groupby("trade_id").exit_pips.max()
    best_event=events.groupby("trade_id").delta_pips.max()
    rows=[]
    for tr in master.itertuples(index=False):
        state_best=float(best_state.get(tr.trade_id,tr.baseline_pips));state_delta=state_best-float(tr.baseline_pips)
        event_delta=float(best_event.get(tr.trade_id,0.0))
        rows.append({"trade_id":tr.trade_id,"strategy":tr.strategy,"fold":tr.fold,"baseline_loser":bool(tr.baseline_loser),"baseline_pips":float(tr.baseline_pips),"state_best_delta":state_delta,"event_best_delta":event_delta})
    o=pd.DataFrame(rows)
    loss=o[o.baseline_loser]
    fixed=[]
    for cp in FIXED_CHECKPOINTS:
        q=states[states.minutes==cp]
        for strategy in STRATEGIES:
            g=q[q.strategy==strategy]
            fixed.append({"strategy":strategy,"checkpoint_minutes":cp,"trades_available":len(g),"all_trade_delta_pips":round(float(g.delta_pips.sum()),1),"loser_only_delta_pips":round(float(g[g.baseline_loser==1].delta_pips.sum()),1),"winner_delta_pips":round(float(g[g.baseline_loser==0].delta_pips.sum()),1)})
    loss_state=float(loss.state_best_delta.clip(lower=0).sum());loss_event=float(loss.event_best_delta.clip(lower=0).sum())
    return {
        "loss_only_5m_oracle_salvage_pips":round(loss_state,1),
        "loss_only_atlas_candidate_oracle_salvage_pips":round(loss_event,1),
        "atlas_candidate_capture_ratio":round(loss_event/max(loss_state,1e-9),6),
        "universal_5m_oracle_improvement_pips":round(float(o.state_best_delta.clip(lower=0).sum()),1),
        "loser_count":len(loss),"fixed_checkpoint_benchmarks":fixed,
        "lookahead_diagnostic_only":True,
    }


def summarize_survivors(summaries:list[dict[str,Any]])->list[dict[str,Any]]:
    return [x for x in summaries if x["binding_gate_pass"]]


def main()->int:
    ap=argparse.ArgumentParser();ap.add_argument("--protocol",type=Path,required=True);ap.add_argument("--preflight-only",action="store_true")
    ap.add_argument("--atlas-dir",type=Path);ap.add_argument("--m15-2023",type=Path);ap.add_argument("--m1-2023",type=Path);ap.add_argument("--events-2024h1",type=Path);ap.add_argument("--events-2024h2",type=Path);ap.add_argument("--m1-2024",type=Path);ap.add_argument("--out-dir",type=Path)
    ap.add_argument("--research-commit",default="");ap.add_argument("--workflow-run-id",default="");ap.add_argument("--workflow-run-attempt",default="")
    args=ap.parse_args();protocol=verify_protocol(args.protocol)
    preflight={"schema_version":"usdjpy_b02_f05_structural_sl_policy_regime_preflight_v3","status":"PASS_NO_OUTCOMES","protocol_sha256":sha256_file(args.protocol),"evaluator_sha256":sha256_file(Path(__file__)),"methods":6,"dynamic_policy_cells":len(STRATEGIES)*len(DYNAMIC_MODELS)*len(DYNAMIC_MARGINS)*len(PERSISTENCE),"hmm_policy_cells":len(STRATEGIES)*len(HMM_COMPONENTS)*len(PERSISTENCE),"outcomes_computed":False,"mt4_accessed":False,"2025_accessed":False,"candidate_frozen":False,"notion_task_dependency":False}
    if args.preflight_only:print(json.dumps(preflight,indent=2,sort_keys=True));return 0
    if any(x is None for x in [args.atlas_dir,args.m15_2023,args.m1_2023,args.events_2024h1,args.events_2024h2,args.m1_2024,args.out_dir]):raise SystemExit("full evaluation requires all inputs")
    args.out_dir.mkdir(parents=True,exist_ok=True);write_json(args.out_dir/"preflight_result_v3.json",preflight)
    events,atlas_metrics,diag=load_atlas(args.atlas_dir,protocol);trades,m23,m24,source_sha=load_sources(args,protocol);master=make_master(trades,diag)
    print(json.dumps({"stage":"monthly_walk_forward"}),file=sys.stderr);mw_detail,mw_summary=monthly_walk_forward(events,master)
    print(json.dumps({"stage":"regime_router"}),file=sys.stderr);rr_detail,rr_summary=ex_ante_regime_router(events,master)
    print(json.dumps({"stage":"family_vote"}),file=sys.stderr);fv_detail,fv_summary=family_vote(events,master)
    print(json.dumps({"stage":"state_ledger"}),file=sys.stderr);states=build_state_ledger(trades,m23,m24)
    print(json.dumps({"stage":"dynamic_policy","state_rows":len(states)}),file=sys.stderr);dp_detail,dp_summary=dynamic_policy_audit(states,master)
    print(json.dumps({"stage":"hmm"}),file=sys.stderr);hmm_detail,hmm_summary=hmm_policy_audit(states,master)
    oracle=oracle_bounds(states,events,master)
    summaries=mw_summary+rr_summary+fv_summary+dp_summary+hmm_summary;survivors=summarize_survivors(summaries)
    status="POLICY_REGIME_AUDIT_COMPLETE_SURVIVOR_REQUIRES_FULL_REPLAY" if survivors else "POLICY_REGIME_AUDIT_COMPLETE_NO_SURVIVOR"
    pd.DataFrame(summaries).to_csv(args.out_dir/"policy_summary_v3.csv",index=False)
    mw_detail.to_csv(args.out_dir/"monthly_walk_forward_v3.csv",index=False);rr_detail.to_csv(args.out_dir/"regime_router_v3.csv",index=False);fv_detail.to_csv(args.out_dir/"family_vote_v3.csv",index=False);dp_detail.to_csv(args.out_dir/"dynamic_policy_v3.csv",index=False);hmm_detail.to_csv(args.out_dir/"hmm_policy_v3.csv",index=False);states.to_csv(args.out_dir/"state_ledger_5m_v3.csv.gz",index=False,compression="gzip",float_format="%.6f")
    top=sorted(summaries,key=lambda x:x["total_delta_pips"],reverse=True)[:20]
    result={
        "schema_version":"usdjpy_b02_f05_structural_sl_policy_regime_result_v3","status":status,"research_commit":args.research_commit,"workflow_run_id":int(args.workflow_run_id) if args.workflow_run_id else None,"workflow_run_attempt":int(args.workflow_run_attempt) if args.workflow_run_attempt else None,
        "population":{"trade_count":len(master),"baseline_loser_count":int(master.baseline_loser.sum()),"state_rows":len(states)},"source_sha256":source_sha,
        "methods":{"monthly_walk_forward_cells":len(mw_summary),"regime_router_cells":len(rr_summary),"family_vote_cells":len(fv_summary),"dynamic_policy_cells":len(dp_summary),"hmm_policy_cells":len(hmm_summary)},
        "survivor_count":len(survivors),"survivors":survivors,"top_pooled_policies":top,"oracle_bounds":oracle,
        "decision":{"candidate_frozen":False,"implementation_authorized":False,"survivor_requires_full_admission_portfolio_replay":True,"survivor_requires_raw_tick_event_order":True,"survivor_requires_mt4_parity":True,"existing_F05_failed_reclaim_unchanged":True},
        "boundaries":{"fixed_pip_stop_evaluated":False,"full_admission_portfolio_replay_computed":False,"mt4_accessed":False,"2025H1_accessed":False,"2025H2_accessed":False,"notion_used_as_task_source":False,"closed_hypotheses_reopened":False},
    }
    write_json(args.out_dir/"result_v3.json",result)
    manifest={"schema_version":"usdjpy_b02_f05_structural_sl_policy_regime_output_manifest_v3","files":{p.name:{"bytes":p.stat().st_size,"sha256":sha256_file(p)} for p in sorted(args.out_dir.iterdir()) if p.is_file()}}
    write_json(args.out_dir/"output_manifest_v3.json",manifest)
    print(json.dumps({"status":status,"trades":len(master),"state_rows":len(states),"policy_cells":len(summaries),"survivors":len(survivors)},sort_keys=True))
    return 0

if __name__=="__main__":raise SystemExit(main())
